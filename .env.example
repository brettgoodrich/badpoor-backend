# Copy to .env. The app runs on sample data without these.
# Never commit .env. The client secret and any access token are secrets
# and stay in this file, on the server. They are not logged.

# Store domain only, no https:// and no path.
SHOPIFY_STORE_DOMAIN=feb098-c4.myshopify.com

# Dev Dashboard app credentials. The app exchanges these for a 24-hour token.
# Leave both blank until the app is installed on the store.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional. If set, this static Admin API token is used instead of the
# client credentials grant. For a legacy custom app created before 2026,
# or a token you already obtained by hand.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Latest stable Admin API version this codebase was written against.
SHOPIFY_API_VERSION=2026-10

# Local database. Gitignored. Created by npm run db:migrate, db:reset, or the first page load.
DATABASE_PATH=./data/inventory.sqlite

# S&S Activewear ordering. Server-only. Leave blank until you want to map
# styles or place an order. Put the real values in .env.local (gitignored);
# Next.js loads it on the server and it overrides this file.
# Basic auth username is the account number. Password is the API key.
# They are never sent to the browser, stored in SQLite, or written to logs.
# https://api.ssactivewear.com/v2/  (60 requests per minute)
SS_ACCOUNT_NUMBER=
SS_API_KEY=
