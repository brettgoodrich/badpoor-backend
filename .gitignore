# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is the only one that belongs in git
.env*
!.env.example

# local sqlite inventory (never commit a database)
/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
